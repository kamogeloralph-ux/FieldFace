# Postgres connection string from Supabase (Project Settings -> Database -> Connection string -> URI)
DATABASE_URL=postgresql://postgres:password@db.xxxxxxxx.supabase.co:5432/postgres

# Supabase project settings (Project Settings -> API)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cloudflare R2 (Project Settings -> R2 -> Manage R2 API Tokens)
CF_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# Optional overrides — defaults match the buckets already created for this app
R2_BUCKET_SELFIES=fieldface-selfies
R2_BUCKET_SITE_PHOTOS=fieldface-site-photos
R2_BUCKET_PAYSLIPS=fieldface-payslips

# Secret used to sign employee/admin session cookies. Use a long random string.
SESSION_SECRET=change-this-to-a-long-random-string

# Default geofence radius (metres) used when a site doesn't set its own
DEFAULT_GEOFENCE_RADIUS_METERS=150

PORT=3001

# Client-side (Vite exposes anything prefixed VITE_ to the browser bundle).
# Only the anon/public key goes here — never the service role key.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
